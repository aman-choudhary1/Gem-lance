# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Extra comma-separated origins allowed by CORS (optional)
CORS_ORIGINS=
# Set to true when running behind nginx / a load balancer
TRUST_PROXY=false

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auctionlens?schema=public"

# Authentication & Security
# In production the server refuses to start unless both are random values of 32+ characters
# that differ from each other. Generate with: openssl rand -hex 32
JWT_SECRET="auctionlens-dev-only-access-secret"
JWT_REFRESH_SECRET="auctionlens-dev-only-refresh-secret"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Data Providers & Scraper Settings
# mock = clearly labelled sample data only, live = real portals only, all = both
DATA_PROVIDER=mock
# Some NIC/state portals serve incomplete TLS chains. Leave false unless you accept the risk.
GEPNIC_ALLOW_INSECURE_TLS=false
SCRAPER_ENABLED=true
SCRAPE_INTERVAL_MINUTES=30
GEM_BASE_URL=https://forwardauction.gem.gov.in
MSTC_BASE_URL=https://www.mstcecommerce.com

# Redis / BullMQ (Prepared for scaling)
REDIS_URL="redis://localhost:6379"

# Notification / Email (Optional for alerts)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AuctionLens Alerts <alerts@auctionlens.io>"

# Initial Admin Credentials (for seed script). Must be changed before seeding production.
ADMIN_EMAIL="admin@auctionlens.io"
ADMIN_PASSWORD="AdminPassword@2026"
ADMIN_NAME="System Administrator"
