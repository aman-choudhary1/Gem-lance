# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auctionlens?schema=public"

# Authentication & Security
JWT_SECRET="auctionlens-super-secret-jwt-key-change-in-production-2026"
JWT_REFRESH_SECRET="auctionlens-super-refresh-secret-jwt-key-2026"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Data Providers & Scraper Settings
# Options: "mock", "gem", "all"
DATA_PROVIDER=mock
SCRAPER_ENABLED=true
SCRAPE_INTERVAL_MINUTES=30
GEM_BASE_URL=https://forwardauction.gem.gov.in
MSTC_BASE_URL=https://www.mstcecommerce.com

# Redis / BullMQ (Prepared for scaling)
REDIS_URL="redis://localhost:6379"

# Notification / Email (Optional for alerts)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AuctionLens Alerts <alerts@auctionlens.io>"

# Initial Admin Credentials (for seed script)
ADMIN_EMAIL="admin@auctionlens.io"
ADMIN_PASSWORD="AdminPassword@2026"
ADMIN_NAME="System Administrator"
