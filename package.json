{
  "name": "auctionlens-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AuctionLens - Multi-Portal Auction Intelligence & Aggregation Platform",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "prisma:seed": "npm --prefix backend run prisma:seed",
    "test": "npm --prefix backend test"
  },
  "keywords": [
    "auction",
    "gem",
    "mstc",
    "forward-auction",
    "intelligence",
    "aggregation"
  ],
  "author": "AuctionLens Core Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
